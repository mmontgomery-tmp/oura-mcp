# Copy to deploy.env (git-ignored) and fill in. Read by scripts/*.sh and `npm run oura-auth`.
# Nothing here is a credential, but it is personal: keep deploy.env out of git.
AWS_REGION=us-east-1
STACK_NAME=oura-mcp
PARAM_PREFIX=/oura-mcp
BUDGET_EMAIL=you@example.com
BUDGET_LIMIT_USD=1
USER_TZ=America/Los_Angeles
# The most requests served at once. A chat can make three tool calls at once, and the Health Auto
# Export automations push together every 5 minutes.
RESERVED_CONCURRENCY=5
# true lets scripts/health-smoke.sh use its test clock (the x-smoke-test-now header, test data
# dated before 2010 only). Leave it false unless you are running that script.
ALLOW_TEST_CLOCK=false
